---
import BaseLayout from  "../../layouts/BasePage.astro";
import { OutsideLink } from "../../components/commonComponents";
import ImageCarousel from "../../components/ImageCarousel.astro";


const title = "Provenance"
const description = "A tactile-audio narrative piece about feeling in the dark, making meaning out of the world around us, and what it means to belong. "

const images = import.meta.glob<{ default: ImageMetadata, eager: true}>('/src/images/provenance_documentation/*.{jpeg,jpg,png,gif}');
const imagesInfo = 
    [
        {imagePath:"/src/images/provenance_documentation/pieces_dark.jpg", 
            altText:"Wooden puzzle pieces in a jumble inside and around a wooden frame."},
        {imagePath:"/src/images/provenance_documentation/glowing_hole.jpg", 
            altText:"`A hand holds a puzzle piece over a glowing hole, poised to fit it inside."},
        {imagePath:"/src/images/provenance_documentation/full_table_interaction.jpg", 
            altText:"`A person sitting at a table reaches out to feel the shapes of a puzzle in front of them."},
        {imagePath:"/src/images/provenance_documentation/spin.jpg", 
            altText:"A hand spins a small wooden wheel"},
        {imagePath: "/src/images/provenance_documentation/choice.jpg",
            altText: "A hand feels the pattern on one side of a two-sided switch"},
        {imagePath: "/src/images/provenance_documentation/piece_closeup.jpg",
            altText: "A hand fits a wooden puzzle piece into place"},
        {imagePath:"/src/images/provenance_documentation/full_puzzle.jpg", 
            altText:"A completed puzzle contains a drawing of a girl holding a small object, with beams of light radiating around them."},
    ]  


---

<BaseLayout content={{title: title,  description: description}} >

    <meta http-equiv = "refresh" content = "0 ; url = https://www.tickettailor.com/events/thecelltheatre/2002023"/>

